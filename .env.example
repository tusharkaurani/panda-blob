# All three values are on the same page: Settings > API in the Supabase dashboard.

# Project URL — used both server-side and in the browser, so it's NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key — safe to expose in the browser. Not currently shipped to any
# client bundle (login/logout run server-side), but Supabase's own auth token
# endpoint still expects it.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key — full DB access bypassing RLS. Server-only, never expose this one
# to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SECRET_KEY=

# Optional defense-in-depth: only this email is treated as the admin even if
# another Supabase Auth user somehow gets created
ADMIN_EMAIL=
